{
    "name": "codevamp-monorepo",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:api": "npm run start:dev -w api",
        "dev:web": "npm run dev -w web",
        "dev:worker": "npm run dev -w worker",
        "build:api": "npm run build -w api",
        "build:web": "npm run build -w web",
        "build:worker": "npm run build -w worker",
        "start:api": "npm run start:prod -w api",
        "start:worker": "npm run start -w worker",
        "install:all": "npm install && npm install --prefix apps/api && npm install --prefix apps/web && npm install --prefix apps/worker",
        "infra:up": "docker-compose up -d",
        "infra:down": "docker-compose down"
    }
}